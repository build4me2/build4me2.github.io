{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citation-overrides/v1",
  "title": "Reviewed citation overrides",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "overrides"],
  "properties": {
    "schema": {"const": "citation-overrides/v1"},
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "documentIdentity", "citationIdentity", "intent", "destination", "reviewer", "rationale"],
        "oneOf": [
          {"required": ["evidenceText"], "not": {"required": ["evidenceSource"]}},
          {"required": ["evidenceSource"], "not": {"required": ["evidenceText"]}}
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$", "maxLength": 128},
          "documentIdentity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "citationIdentity": {"type": "string", "pattern": "^(?:numeric:[1-9][0-9]{0,2}|author-year:[a-z0-9'’-]+:(?:18|19|20)[0-9]{2}[a-z]?|destination:https?://\\S+)$"},
          "intent": {"const": "resolve-citation-destination"},
          "destination": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
          "reviewer": {"type": "string", "minLength": 1, "maxLength": 300},
          "evidenceText": {"type": "string", "minLength": 1, "maxLength": 4000},
          "evidenceSource": {"type": "string", "minLength": 1, "maxLength": 2048},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    }
  }
}
